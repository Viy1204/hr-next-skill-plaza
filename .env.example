# 跑 scripts/setup-bitable.sh 生成下面这批值。切勿建在任何人的公司租户里（见 ADR-0005）。
# 飞书自建应用凭证（开放平台 → 凭证与基础信息）
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=xxx

# 多维表格：HR NEXT 技能广场
BITABLE_BASE_TOKEN=
BITABLE_TABLE_PACKAGES=
BITABLE_TABLE_ENTRIES=
BITABLE_TABLE_WISHES=
BITABLE_TABLE_ENDORSEMENTS=
BITABLE_TABLE_CLAIMS=
BITABLE_TABLE_CONFIG=

# 自助上传的 zip 存在云空间；留空则传到应用自己的根目录
FEISHU_DRIVE_FOLDER_TOKEN=
# 运营的 open_id：上传后把文件查看权限给他，否则他审核时打不开要审的 zip
FEISHU_REVIEWER_OPEN_ID=

# HR NEXT 群自定义机器人 webhook；不配则只打日志，不阻塞许愿
FEISHU_GROUP_WEBHOOK_URL=

# 交付同步接口的共享密钥（运营在多维表格里关联技能包后调用）
DELIVERY_SYNC_SECRET=

# 推送文案里的链接前缀
PUBLIC_BASE_URL=http://localhost:3000
