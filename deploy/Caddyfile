# /etc/caddy/Caddyfile
#
# Caddy 占 80/443，向 Let's Encrypt 自动签发并续期证书；应用只听 127.0.0.1:3000。
# 80 必须保持放行：ACME 的 HTTP challenge 走它，关掉证书就续不了。

{
	email yifan@lepro.com
}

viy1204.me {
	# 应用侧的 20MB 上限在整个 body 读进内存之后才检查得到，而进程被
	# MemoryMax=400M 封顶 —— 超大请求必须在这里就掐断，别让 Node 见到它。
	request_body {
		max_size 25MB
	}
	reverse_proxy 127.0.0.1:3000
	encode gzip
	log {
		output file /var/log/caddy/access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# 站内链接和群推送一律用 apex，www 只做跳转，省得两个地址各自被人收藏。
www.viy1204.me {
	redir https://viy1204.me{uri} permanent
}
