[Unit]
Description=HR NEXT 技能广场
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=plaza
Group=plaza
WorkingDirectory=/opt/hr-plaza/current
EnvironmentFile=/etc/hr-plaza.env
Environment=NODE_ENV=production
Environment=PORT=3000
# 只听回环：入口是 Caddy，进程本身不该能被公网直连。
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3
# 这台机器上还跑着别的服务，内存本来就紧。封顶后撑爆只重启本服务，不拖垮整机。
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
